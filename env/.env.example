# Copy to ApiTests/env/.env (git-ignored) and fill in. Never commit real values.
# The RealWorld demo backend is public and needs no API key; you register a
# throwaway account and the tests obtain a JWT at runtime.

# Target API (staging/demo only - production is blocked by appqe guardrails).
BASE_URL=https://api.realworld.show/api

# Test account. If TEST_EMAIL is unset, the suite registers a fresh random user.
TEST_EMAIL=
TEST_PASSWORD=

# Optional: a pre-minted JWT to skip the login step. Leave blank to auto-login.
token=

# Jira credentials - the only Jira settings that live here. Host, project and
# ac field are in appqe.yml (tracker:). These two are per-developer secrets, so
# they stay out of the committed config. Needed only once tools.jira is wired.
# Token (not your password): id.atlassian.com/manage-profile/security/api-tokens
# JIRA_EMAIL=you@slalom.com
# JIRA_API_TOKEN=<paste-your-atlassian-api-token>
